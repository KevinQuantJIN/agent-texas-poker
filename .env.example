# Option A: OpenRouter (one key for all models — recommended)
OPENROUTER_API_KEY=sk-or-...

# Option B: Direct provider keys (used when OPENROUTER_API_KEY is not set)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=...
XAI_API_KEY=...
DEEPSEEK_API_KEY=...
GROQ_API_KEY=...

# Game server
GAME_SERVER_PORT=3001
DEMO_TOKEN=your-secret-demo-token
ADMIN_TOKEN=your-admin-secret     # POST /api/restart with Bearer token to restart game

# Dev options
MOCK_LLM=false          # true = use mock adapter, no API calls
DECK_SEED=              # set for deterministic shuffle (testing/debugging)
